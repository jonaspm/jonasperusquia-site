---
import socialNetworks from '@/assets/data/social-networks.json'

interface Props {
	content: {
		title: string
		fallbackIntro: string
		emailLabel: string
		bookingLabel: string
		embedError: string
	}
}

const { content } = Astro.props

// Static contact channels (from the resume) — these make the section work
// even when the TidyCal embed cannot load.
const emailHref = 'mailto:jperusm@outlook.com'
const bookingHref = 'https://tidycal.com/jperusm/15-minute-meeting'

// Same curated trio as the hero social row.
const curatedSocials = socialNetworks.filter((social) =>
	['LinkedIn', 'GitHub', 'Email'].includes(social.name),
)
---

<section id="contact" data-tidycal-contact class="py-8 scroll-mt-20 opacity-0">
  <h2 class="mb-12 text-center font-display text-3xl font-semibold tracking-tight text-grayblue-900 dark:text-grayblue-100 gsap-fade-up transition-colors duration-300">{content.title}</h2>
  <div class="flex justify-center gsap-fade-up-noreverse">
    <div class="tidycal-embed" data-tidycal-placeholder data-path="jperusm/15-minute-meeting"></div>
    <script is:inline>
      (() => {
        const tidycalSrc = "https://asset-tidycal.b-cdn.net/js/embed.js";
        // Give the vendor enough time to replace the placeholder before the
        // static fallback error is promoted.
        const embedTimeoutMs = 3500;

        class TidyCalEmbedManager {
          constructor() {
            // WeakMap keys keep detached placeholders collectible while their
            // observers/timers still belong to this manager.
            this.states = new WeakMap();
            // Active states include idle observers, which must be cancelled
            // before Astro swaps their retained DOM out of the document.
            this.activeStates = new Set();
            this.scriptStates = new WeakMap();
            this.loaderPromise = null;
            this.boundObserve = this.observe.bind(this);
            this.boundBeforeSwap = this.cancelActiveStates.bind(this);
            this.initialized = false;
          }

          init() {
            // Astro may execute this inline script again during navigation.
            // Reuse the singleton and register each lifecycle listener once.
            if (!this.initialized) {
              document.addEventListener("astro:page-load", this.boundObserve);
              document.addEventListener("astro:after-swap", this.boundObserve);
              document.addEventListener("astro:before-swap", this.boundBeforeSwap);
              this.initialized = true;
            }

            this.observe();
          }

          // Idle IntersectionObservers retain their targets. Stop every active
          // state before Astro detaches the old document subtree.
          cancelActiveStates() {
            for (const state of [...this.activeStates]) {
              this.cancel(state);
            }
          }

          // Lazy-load the below-the-fold widget. Each placeholder owns one
          // observer/state, so repeated lifecycle events cannot double-init.
          observe() {
            const placeholders = document.querySelectorAll(
              "[data-tidycal-contact] [data-tidycal-placeholder]",
            );

            placeholders.forEach((placeholder) => {
              if (!(placeholder instanceof HTMLDivElement)) {
                return;
              }

              const root = placeholder.closest("[data-tidycal-contact]");
              const host = placeholder.parentElement;
              if (
                !(root instanceof HTMLElement) ||
                !(host instanceof HTMLElement) ||
                !root.isConnected
              ) {
                return;
              }

              let state = this.states.get(placeholder);
              if (!state) {
                state = {
                  root,
                  host,
                  phase: "idle",
                  observer: null,
                  mutations: null,
                  timer: null,
                };
                this.states.set(placeholder, state);
                this.activeStates.add(state);
              }

              if (state.phase !== "idle" || state.observer) {
                return;
              }

              // Older browsers without IntersectionObserver still get a
              // working embed; they simply hydrate it immediately.
              if (typeof window.IntersectionObserver !== "function") {
                this.hydrate(placeholder, state);
                return;
              }

              const observer = new IntersectionObserver(
                (entries) => {
                  if (!entries.some((entry) => entry.isIntersecting)) {
                    return;
                  }
                  observer.disconnect();
                  this.hydrate(placeholder, state);
                },
                // Start slightly before the section enters the viewport so the
                // iframe has time to load while the user scrolls toward it.
                { rootMargin: "200px 0px" },
              );
              state.observer = observer;
              observer.observe(placeholder);
            });
          }

          async hydrate(placeholder, state) {
            // The phase is the single init guard. It replaces dataset flags,
            // which became stale when TidyCal detached the placeholder.
            if (state.phase !== "idle") {
              return;
            }
            state.phase = "loading";
            state.observer?.disconnect();
            state.observer = null;

            // A retained iframe can already coexist with the placeholder after
            // navigation. Adopt it without requesting the vendor again, which
            // would otherwise create a duplicate iframe.
            if (this.hasEmbed(state)) {
              this.markInjectedIframesLazy(state);
              this.markReady(state);
              return;
            }

            // Watch before awaiting the vendor: TidyCal can replace the
            // placeholder synchronously and may throw after inserting its
            // iframe. The captured host remains the source of truth.
            this.armWatchers(placeholder, state);

            try {
              await this.ensureScriptLoaded();
            } catch {
              // A concurrent iframe insertion wins over a late request error.
              if (state.phase !== "loading") {
                return;
              }
              if (this.isDisconnected(state)) {
                this.cancel(state);
                return;
              }
              this.showFallback(placeholder, state);
              return;
            }

            // MutationObserver may already have completed this state while the
            // vendor request was pending. A late vendor success must also
            // replace a timeout fallback that was shown while the script loaded.
            if (state.phase !== "loading" && state.phase !== "failed") {
              return;
            }

            if (this.hasEmbed(state)) {
              this.markReady(state);
              return;
            }

            // A view transition may remove this section while the script is
            // loading. Do not init or alter a detached subtree.
            if (this.isDisconnected(state)) {
              this.cancel(state);
              return;
            }

            // Some vendor loads resolve without exposing init. Keep the
            // watchdog armed rather than declaring success or failure early.
            if (!window.TidyCal?.init) {
              return;
            }

            try {
              window.TidyCal.init(placeholder);
            } catch {
              // TidyCal's iframe-resizer plumbing can throw after the iframe
              // has already landed. Only an actually absent iframe waits for
              // the watchdog fallback.
              if (this.hasEmbed(state)) {
                this.markReady(state);
              }
              return;
            }

            // init() may insert synchronously; otherwise the mutation observer
            // or watchdog will resolve the still-loading state.
            if (this.hasEmbed(state)) {
              this.markReady(state);
            }
          }

          // Arm both watchers before any vendor await so a fast replacement is
          // observed and a silent vendor failure still has a bounded fallback.
          armWatchers(placeholder, state) {
            this.markInjectedIframesLazy(state);

            if (typeof window.MutationObserver === "function") {
              const mutations = new MutationObserver(() => {
                if (state.phase !== "loading") {
                  return;
                }
                this.markInjectedIframesLazy(state);
                if (this.hasEmbed(state)) {
                  this.markReady(state);
                }
              });
              // Observe only the captured embed host, never document.body.
              mutations.observe(state.host, { childList: true, subtree: true });
              state.mutations = mutations;
            }

            state.timer = window.setTimeout(() => {
              this.watchdog(placeholder, state);
            }, embedTimeoutMs);
          }

          // Success is based on the live host subtree. Placeholder attributes
          // are intentionally ignored because the vendor detaches that node.
          hasEmbed(state) {
            return Boolean(state.host.querySelector("iframe.tidycal-embed"));
          }

          // Stamp only iframes inside this embed host; childList observation
          // means setting the loading attribute cannot retrigger the observer.
          markInjectedIframesLazy(state) {
            state.host.querySelectorAll("iframe").forEach((iframe) => {
              iframe.loading = "lazy";
            });
          }

          watchdog(placeholder, state) {
            // Ready/failed/cancelled states are terminal; stale timers are inert.
            if (state.phase !== "loading") {
              return;
            }

            // A swapped-away section must not receive fallback UI changes.
            if (this.isDisconnected(state)) {
              this.cancel(state);
              return;
            }

            if (this.hasEmbed(state)) {
              this.markReady(state);
              return;
            }

            this.showFallback(placeholder, state);
          }

          isDisconnected(state) {
            // TidyCal may detach only the placeholder while keeping the embed
            // host alive. Only a removed section/host should cancel cleanup.
            return !state.root.isConnected || !state.host.isConnected;
          }

          markReady(state) {
            if (state.phase !== "loading" && state.phase !== "failed") {
              return;
            }
            state.phase = "ready";
            this.stopWatchers(state);

            // Success explicitly keeps the scoped error hidden, including when
            // a previous state briefly exposed it.
            const errorLine = state.root.querySelector("[data-tidycal-error]");
            if (errorLine instanceof HTMLElement) {
              errorLine.classList.add("hidden");
            }
          }

          showFallback(placeholder, state) {
            if (state.phase !== "loading") {
              return;
            }
            state.phase = "failed";
            this.stopWatchers(state);
            placeholder.style.display = "none";

            // Never query globally: another contact section must not be hidden
            // or have its error message revealed by this widget.
            const errorLine = state.root.querySelector("[data-tidycal-error]");
            if (errorLine instanceof HTMLElement) {
              errorLine.classList.remove("hidden");
            }
          }

          cancel(state) {
            if (state.phase === "ready" || state.phase === "failed") {
              return;
            }
            state.phase = "cancelled";
            this.stopWatchers(state);
          }

          stopWatchers(state) {
            state.observer?.disconnect();
            state.observer = null;
            state.mutations?.disconnect();
            state.mutations = null;
            if (state.timer !== null) {
              window.clearTimeout(state.timer);
              state.timer = null;
            }
            this.activeStates.delete(state);
          }

          ensureScriptLoaded() {
            if (window.TidyCal?.init) {
              return Promise.resolve();
            }

            if (this.loaderPromise) {
              return this.loaderPromise;
            }

            let script = document.querySelector(
              "script[data-tidycal-script='true']",
            );
            if (script instanceof HTMLScriptElement) {
              const status = this.scriptStates.get(script);
              if (status === "loaded") {
                return Promise.resolve();
              }
              // A failed request must not poison later navigations forever.
              // Remove only our rejected script so the next section can retry.
              if (status === "error") {
                script.remove();
                script = null;
              }
            }

            const loaderPromise = new Promise((resolve, reject) => {
              if (!(script instanceof HTMLScriptElement)) {
                script = document.createElement("script");
                script.src = tidycalSrc;
                script.async = true;
                script.dataset.tidycalScript = "true";
                this.scriptStates.set(script, "pending");
                document.head.appendChild(script);
              }

              script.addEventListener(
                "load",
                () => {
                  this.scriptStates.set(script, "loaded");
                  resolve();
                },
                { once: true },
              );
              script.addEventListener(
                "error",
                () => {
                  this.scriptStates.set(script, "error");
                  reject(new Error("TidyCal script failed to load"));
                },
                { once: true },
              );
            });

            this.loaderPromise = loaderPromise;
            // Let later placeholders retry instead of permanently reusing a
            // rejected promise. The caller still receives the rejection.
            loaderPromise.catch(() => {
              if (this.loaderPromise === loaderPromise) {
                this.loaderPromise = null;
              }
            });

            return loaderPromise;
          }
        }

        window.tidycalEmbedManager ||= new TidyCalEmbedManager();
        window.tidycalEmbedManager.init();
      })();
    </script>
  </div>

  {/* Always-visible fallback panel (design §3.7): works even if the embed
      never loads — no JS guessing required. The `data-tidycal-error` line is
      revealed by the watchdog above when the embed fails. */}
  <div class="mx-auto mt-10 max-w-2xl rounded-card-lg bg-white/80 dark:bg-grayblue-800/70 backdrop-blur-sm border border-grayblue-200/80 dark:border-grayblue-700/60 p-8 lg:p-10 shadow-soft text-center gsap-fade-up-noreverse">
    <p data-tidycal-error role="status" aria-live="polite" aria-atomic="true" class="hidden mb-6 text-sm italic text-grayblue-500 dark:text-grayblue-400">
      {content.embedError}
    </p>
    <p class="text-base lg:text-lg leading-relaxed text-grayblue-700 dark:text-grayblue-300">
      {content.fallbackIntro}
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-4">
      <a
        href={emailHref}
        class="rounded-full bg-blue-600 text-white px-6 py-3 text-sm font-medium shadow-glow-blue transition-colors duration-300 hover:bg-blue-700"
      >
        {content.emailLabel}
      </a>
      <a
        href={bookingHref}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-blue-500/60 text-blue-600 dark:text-blue-300 px-6 py-3 text-sm font-medium transition-colors duration-300 hover:bg-blue-600 hover:text-white"
      >
        {content.bookingLabel}
      </a>
    </div>
    <div class="mt-6 flex justify-center gap-4">
      {
        curatedSocials.map((socialNetwork) => (
          <a
            aria-label={socialNetwork.name === 'Email' ? content.emailLabel : socialNetwork.name}
            href={socialNetwork.url}
            class="text-grayblue-600 dark:text-grayblue-300 hover:text-blue-500 dark:hover:text-blue-300 transition-all duration-300 hover:scale-110"
          >
            <div class="h-6 w-6">
              <Fragment set:html={socialNetwork.image} />
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
